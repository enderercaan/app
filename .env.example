# Tailmance mobile/client + native build/CI environment template.
# Do not place Supabase service-role keys or Edge/server secrets here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=tailmance_premium
EXPO_PUBLIC_REVENUECAT_PREMIUM_PACKAGE_ID=premium_access
EXPO_PUBLIC_REVENUECAT_BOOST_PRODUCT_IDS=tailmance_boost_1,tailmance_boost_5
EXPO_PUBLIC_REVENUECAT_SUPER_LIKE_PRODUCT_IDS=tailmance_superlike_5,tailmance_superlike_20
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/idREPLACE
EXPO_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.tailmance.app
EXPO_PUBLIC_LEGAL_VERSION=2026-09-28-v19
EXPO_PUBLIC_TERMS_VERSION=2026-09-28-v19
EXPO_PUBLIC_COMMUNITY_GUIDELINES_VERSION=2026-09-28-v19
EXPO_PUBLIC_PRIVACY_NOTICE_VERSION=2026-09-28-v19
EXPO_PUBLIC_MARKETING_PUSH_CONSENT_VERSION=2026-09-28-v19
EXPO_PUBLIC_ENABLE_DEMO=false
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
EXPO_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
EXPO_PUBLIC_AUTH_CHALLENGE_URL=https://YOUR_WEB_ORIGIN/auth-challenge.html
EXPO_PUBLIC_APP_LINK_HOST=REPLACE_WITH_PUBLIC_APP_LINK_HOST
EXPO_PUBLIC_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=123456789012
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_OAUTH_CLIENT_ID

# Native build / CI only. These are not EXPO_PUBLIC values.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_SERVICES_JSON=
GOOGLE_IOS_URL_SCHEME=
GOOGLE_SERVICE_INFO_PLIST=
APPLE_TEAM_ID=
ANDROID_APP_LINK_CERT_SHA256=
EXPO_PUBLIC_EDGE_AI_MODEL_MANIFEST_URL=
EXPO_PUBLIC_EDGE_AI_MODEL_MANIFEST_SHA256=
