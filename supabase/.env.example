# Tailmance Supabase / Edge Functions environment template
# TEMPLATE ONLY. Never place production secrets in source control.
# Configure real values in the Supabase/hosting secret manager for each environment.

# Supabase service access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Serverless Redis cache acceleration (authorization remains Postgres-authoritative)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth provider token revocation for account deletion.
# The AES-256 key is a 32-byte random value encoded as standard base64 and belongs only in the secret manager.
OAUTH_REVOCATION_CREDENTIAL_KEY_B64=
OAUTH_REVOCATION_CREDENTIAL_KEY_VERSION=
# JSON object of up to four prior key-version -> canonical-base64 AES-256 keys. Keep only during rotation until all rows using them are re-captured/deleted.
OAUTH_REVOCATION_CREDENTIAL_PREVIOUS_KEYS_JSON={}
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_PRIVATE_KEY_P8=
APPLE_SIGN_IN_NATIVE_CLIENT_ID=
GOOGLE_OAUTH_SERVER_CLIENT_ID=
GOOGLE_OAUTH_SERVER_CLIENT_SECRET=
GOOGLE_OAUTH_SERVER_REDIRECT_URI=

# RevenueCat subscriptions + consumables
REVENUECAT_REST_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_WEBHOOK_ENVIRONMENT=PRODUCTION
REVENUECAT_ALLOWED_APP_IDS_JSON=[]
REVENUECAT_ENTITLEMENT_ID=tailmance_premium
REVENUECAT_CONSUMABLE_PRODUCTS_JSON={}

# Scheduled / admin worker bearer secrets
PUSH_WORKER_SECRET=
LIVEKIT_ROOM_REAPER_SECRET=
STORAGE_GC_SECRET=
EXTERNAL_DELETION_WORKER_SECRET=
ACCOUNT_DELETION_ADMIN_SECRET=
REMINDER_WORKER_SECRET=
MODERATION_WORKER_SECRET=
MODERATION_ADMIN_SECRET=
MODERATION_APPEALS_ADMIN_SECRET=
REPORTS_ADMIN_SECRET=
OPS_HEALTH_SECRET=
SECURITY_ADMIN_SECRET=

# Moderation provider
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_ALLOWED_HOSTS_JSON=[]

# Health / identity verification webhooks
HEALTH_VERIFICATION_WEBHOOK_SECRET=
IDENTITY_WEBHOOK_SECRET=

# Web deletion / CORS / Turnstile
CORS_ALLOWED_ORIGIN=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=account_deletion

# Google Play Integrity
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON={}
PLAY_INTEGRITY_PACKAGE_NAME=com.tailmance.app
PLAY_INTEGRITY_ALLOWED_CERT_SHA256=
PLAY_INTEGRITY_ALLOWED_VERSION_CODES=
PLAY_INTEGRITY_REQUIRE_LICENSED=true

# Apple App Attest verification service
APPLE_APP_ATTEST_VERIFIER_URL=
APPLE_APP_ATTEST_VERIFIER_SECRET=
APPLE_APP_ATTEST_APP_ID=
APPLE_APP_ATTEST_VERIFIER_ALLOWED_HOSTS_JSON=[]

# Owner identity verification provider
IDENTITY_PROVIDER_SESSION_URL=
IDENTITY_PROVIDER_SECRET=
IDENTITY_PROVIDER_RETURN_URL=tailmance://verification-complete
IDENTITY_PROVIDER_ALLOWED_HOSTS_JSON=[]

# Optional dedicated age-assurance provider. If any of the first three are set,
# all three must be configured. If omitted, the identity-provider configuration is used.
AGE_ASSURANCE_PROVIDER_SESSION_URL=
AGE_ASSURANCE_PROVIDER_SECRET=
AGE_ASSURANCE_PROVIDER_ALLOWED_HOSTS_JSON=[]
AGE_ASSURANCE_PROVIDER_RETURN_URL=tailmance://age-verification-complete

# Apple PushKit / CallKit VoIP delivery. Server-only; never ship the .p8 key to clients.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_VOIP_PRIVATE_KEY_P8=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production

# LiveKit SFU credentials for matched-pet audio/video calls.
# The client receives only a short-lived room-scoped participant token from the
# livekit-call-token Edge Function. API key/secret are server-only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Legal document version identifiers
TAILMANCE_LEGAL_VERSION=
TAILMANCE_TERMS_VERSION=
TAILMANCE_COMMUNITY_GUIDELINES_VERSION=
TAILMANCE_PRIVACY_NOTICE_VERSION=

# Hosted Supabase Auth CAPTCHA secret referenced by supabase/config.toml.
# This is configured in the hosted/local Supabase Auth environment, not shipped to clients.
SUPABASE_AUTH_CAPTCHA_SECRET=

# Registry-backed veterinary OCR/AI worker. Never ship these values to clients.
HEALTH_AI_WORKER_SECRET=
HEALTH_AI_API_URL=
HEALTH_AI_API_KEY=
HEALTH_AI_ALLOWED_HOSTS_JSON=[]
HEALTH_AI_PROVIDER_CODE=
